# Server Ports
ADMIN_PORT=3000
PUBLIC_PORT=3001

# Public URL exposed via Tunnel/ngrok (Used for tracking and unsubscribe links)
PUBLIC_BASE_URL=https://track.yourdomain.com

# 32-byte hexadecimal encryption key for AES-256-GCM mailbox credentials (MANDATORY: 64 hex chars)
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mandatory Admin API Key protection (leave blank to auto-generate into data/.admin_key on first startup)
API_KEY=

# Database file location
DB_PATH=mailcheck.db

# Queue and Concurrency Limits
MAX_GLOBAL_CONCURRENCY=10
RATE_LIMIT_PER_HOST_MS=1500
